# ---- Database ----
# Local dev (no Postgres needed): pip install aiosqlite, then
DATABASE_URL=sqlite+aiosqlite:///./local.db
# Production (Neon). The ?sslmode=require suffix is handled automatically.
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Seeds the first admin account on first boot only. Changing these later does
# NOT reset an existing password — use POST /api/auth/change-password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,https://abdul-salam111.github.io

# ---- Cloudinary (image uploads; /api/uploads/image returns 503 without these) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
